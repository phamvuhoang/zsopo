# Public (an toàn ở browser). Giá trị local in ra bởi `pnpm exec supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Không đặt service role / secret ở đây. Secret elevated chỉ ở Supabase Edge secrets (supabase/functions/.env).
# Shared with the DB scheduler (Vault revalidate_secret) for scheduled-post revalidation.
REVALIDATE_SECRET=
# Server-only: lets the web server forward the visitor IP to the DB rate limiter (Vault rate_limit_forward_secret).
RATE_LIMIT_FORWARD_SECRET=
